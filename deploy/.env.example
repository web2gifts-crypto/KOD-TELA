# /srv/kodtela/.env на сервере — права 600, владелец root. НЕ коммитить.

# Managed PostgreSQL Timeweb (доступна только из приватной сети). Пароль — в одинарных кавычках, без экранирования.
DB_HOST=192.168.0.5
DB_NAME=default_db
DB_USER=gen_user
DB_PASSWORD=

# токен бота от @BotFather
BOT_TOKEN=

# ключ шифрования данных о здоровье: openssl rand -base64 32
# ПОТЕРЯ КЛЮЧА = ПОТЕРЯ ВСЕХ ДАННЫХ. Сохраните копию в менеджере паролей.
DATA_KEY=

ALLOWED_ORIGINS=https://app.kodtela.tech
# вебхук бота и меню команд (на проде — true)
BOT_WEBHOOK=true
# Telegram ID, куда бот шлёт алерты об ошибках (обычно — свой)
ADMIN_CHAT_ID=
CONSENT_VERSION=2026-11-23.2

# ИИ (GigaChat) — см. docs/AI.md
AI_ENABLED=false
AI_PROVIDER=stub
GIGACHAT_AUTH_KEY=
